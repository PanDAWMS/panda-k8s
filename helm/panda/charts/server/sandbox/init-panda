if [ -f /opt/panda/etc/cert/hostcert.pem ]; then
    echo "Host certificate already mounted."
else
    echo "Host certificate not found. will generate a self-signed one."
    unlink /etc/grid-security/hostkey.pem
    unlink /etc/grid-security/hostcert.pem
    mkdir /opt/panda/config
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -subj "/C=US/DC=IDDS/OU=computers/CN=$(hostname -f)" \
        -keyout /opt/panda/config/hostkey.pem \
        -out /opt/panda/config/hostcert.pem
    ln -fs /opt/panda/config/hostcert.pem /etc/grid-security/hostcert.pem
    ln -fs /opt/panda/config/hostkey.pem /etc/grid-security/hostkey.pem
fi

# fall back to self-referencing the host certificate as its own chain when no
# chain.pem is mounted, so httpd does not fail to start on a dangling
# /etc/grid-security/chain.pem symlink (baked in by the Dockerfile to point at
# /opt/panda/etc/cert/chain.pem) whenever the certs secret only provides a host
# certificate, e.g. via the self-signed fallback above.
if [ ! -f /opt/panda/etc/cert/chain.pem ]; then
    unlink /etc/grid-security/chain.pem
    ln -fs /etc/grid-security/hostcert.pem /etc/grid-security/chain.pem
fi

# copy idds conf
mkdir -p /home/atlpan/.idds
cp /data/panda/idds.cfg /home/atlpan/.idds/idds_local.cfg

# install CA files and fetch info from CRIC before running services
tmpExe=/data/panda/init-panda-tmp-exe
cat <<EOT >> ${tmpExe}
/opt/panda/bin/panda_common-install_igtf_ca > /var/log/panda/install_igtf_ca.log 2>&1
/opt/panda/usr/bin/panda_server-schedconfig_json
/opt/panda/usr/bin/panda_server-configurator
EOT

if [[ ! -z "${EXPERIMENT}" ]]; then
    echo "init experiment ${EXPERIMENT} - CA hook"
    CurrentDir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    ca_hook_script=${CurrentDir}/${EXPERIMENT}.ca-hook
    if [[ -f ${ca_hook_script} ]]; then
        echo "Appending ${ca_hook_script} to ${tmpExe}"
        cat ${ca_hook_script} >> ${tmpExe}
    else
        echo "No ${ca_hook_script} found, skipping"
    fi
fi

chmod +x ${tmpExe}

if [[ -z "${PANDA_NO_ROOT}" ]]; then
  chmod -R 777 /var/log/panda
  runuser -u atlpan -g zp -- ${tmpExe}
else
  ${tmpExe}
fi

# allow experiments to specify additional commands to run after the init-panda script, e.g. to define VOMS files
if [[ ! -z "${EXPERIMENT}" ]]; then
    echo "init experiment ${EXPERIMENT} - post-init hook"
    CurrentDir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    init_hook_script=${CurrentDir}/${EXPERIMENT}.post-init-hook
    if [[ -f ${init_hook_script} ]]; then
        echo "Appending ${init_hook_script} to ${tmpExe}"
        cat ${init_hook_script} >> ${tmpExe}
    else
        echo "No ${init_hook_script} found, skipping"
    fi
fi