# refresh schedconfig json and CA files, and logrotate
tmpExe=/data/panda/run-panda-crons-tmp-exe
cat <<EOT >> ${tmpExe}
while true; do sleep 36000;
  /opt/panda/bin/panda_common-install_igtf_ca > /var/log/panda/install_igtf_ca.log 2>&1;
EOT

# CA hook, executed with the same period as the CA refresh
if [[ ! -z "${EXPERIMENT}" ]]; then
    echo "cron experiment ${EXPERIMENT} - CA hook"
    CurrentDir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    ca_hook_script=${CurrentDir}/${EXPERIMENT}.ca-hook
    if [[ -f ${ca_hook_script} ]]; then
        echo "Appending ${ca_hook_script} to ${tmpExe}"
        cat ${ca_hook_script} >> ${tmpExe}
    else
        echo "No ${ca_hook_script} found, skipping"
    fi
fi

cat <<EOT >> ${tmpExe}
done &
while true; do /opt/cacheschedconfig/bin/cacheSC.sh >> /var/log/panda/cacheSC.out 2>&1; sleep 60; done &
while true; do /usr/sbin/logrotate /data/panda/logrotate-panda >> /var/log/panda/logrotate.log 2>&1; sleep 86400; done &
EOT

# cron hook, e.g. a while loop with a user-defined period, that can be used for example
# to provide VOMS proxy refresh
if [[ ! -z "${EXPERIMENT}" ]]; then
    echo "cron experiment ${EXPERIMENT} - cron hook"
    CurrentDir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    cron_hook_script=${CurrentDir}/${EXPERIMENT}.cron-hook
    if [[ -f ${cron_hook_script} ]]; then
        echo "Appending ${cron_hook_script} to ${tmpExe}"
        cat ${cron_hook_script} >> ${tmpExe}
    else
        echo "No ${cron_hook_script} found, skipping"
    fi
fi

chmod +x ${tmpExe}

if [[ -z "${PANDA_NO_ROOT}" ]]; then
  runuser -u atlpan -g zp -- ${tmpExe} &
else
  ${tmpExe} &
fi
