# copy idds conf
mkdir -p /home/atlpan/.idds
cp /data/panda/idds.cfg /home/atlpan/.idds/idds_local.cfg

# install CA files and fetch info from CRIC before running services
# we allow experiments to specify additional commands to run after the CA
# installation, e.g. to install additional CA files or to fetch info from CRIC,
# by providing a sandbox/<experiment>.ca-hook file;
# the same are used by the run-jedi-crons script to e.g. refresh CA files
tmpExe=/data/panda/init-jedi-tmp-exe
cat <<EOT >> ${tmpExe}
/opt/panda/bin/panda_common-install_igtf_ca > /var/log/panda/install_igtf_ca.log 2>&1
EOT

if [[ ! -z "${EXPERIMENT}" ]]; then
    echo "init experiment ${EXPERIMENT}"
    CurrentDir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    ca_hook_script=${CurrentDir}/${EXPERIMENT}.ca-hook
    if [[ -f ${ca_hook_script} ]]; then
        echo "Appending ${ca_hook_script} to ${tmpExe}"
        cat ${ca_hook_script} >> ${tmpExe}
    else
        echo "No ${ca_hook_script} found, skipping"
    fi
fi

cat <<EOT >> ${tmpExe}
/opt/panda/usr/bin/panda_server-schedconfig_json
/opt/panda/usr/bin/panda_server-configurator
EOT

chmod +x ${tmpExe}


if [[ -z "${PANDA_NO_ROOT}" ]]; then
  chmod -R 777 /var/log/panda
  runuser -u atlpan -g zp -- ${tmpExe}
else
  ${tmpExe}
fi
